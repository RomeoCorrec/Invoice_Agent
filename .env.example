# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by docker-compose and the app)
POSTGRES_USER=invoice_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoice_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://invoice_agent:change-me@localhost:5432/invoice_agent

# Secret key for the IBAN fingerprints (HMAC). At least 16 characters; generate your own,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Changing it invalidates
# every stored fingerprint.
IBAN_HASH_KEY=change-me-to-a-long-random-value

# Ingestion limits (optional, defaults shown)
# MAX_DOCUMENT_BYTES=10485760
# MAX_PDF_PAGES=20
# MAX_XML_BYTES=2097152
# MAX_TEXT_CHARS=100000

# Worker (optional, defaults shown except the document root)
DOCUMENT_ROOT=./documents
# WORKER_POLL_SECONDS=2
# JOB_TIMEOUT_SECONDS=60
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_BASE_SECONDS=5
# JOB_BACKOFF_CAP_SECONDS=600
